      "id": "dee4d187-9bd4-4f97-a589-c5ec0bb976d6",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        560,
        -160
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "CjOen9SQAlTR1qiL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const email = $input.item.json;\nreturn {\n  from: email.from?.value?.[0]?.address || email.from || 'unknown',\n  from_name: email.from?.value?.[0]?.name || '',\n  subject: email.subject || '(no subject)',\n  body: (email.text || email.snippet || '').slice(0, 2000),\n  date: email.date || new Date().toISOString(),\n  message_id: email.id || ''\n};"
      },
      "id": "b29b1b9a-e8c7-4a8a-a7bd-9960691b8ae4",
      "name": "Extract Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices?.[0]?.message?.content || '{}';\nlet cleaned = raw.trim();\nif (cleaned.startsWith('```')) {\n  cleaned = cleaned.split('```')[1];\n  if (cleaned.startsWith('json')) cleaned = cleaned.slice(4);\n  cleaned = cleaned.trim();\n}\ntry {\n  const parsed = JSON.parse(cleaned);\n  return {\n    ...parsed,\n    from: $('Extract Content').item.json.from,\n    from_name: $('Extract Content').item.json.from_name,\n    subject: $('Extract Content').item.json.subject,\n    body: $('Extract Content').item.json.body,\n    date: $('Extract Content').item.json.date,\n    message_id: $('Extract Content').item.json.message_id\n  };\n} catch(e) {\n  return {\n    urgency: 'low',\n    category: 'general',\n    sentiment: 'neutral',\n    summary: 'Could not parse email',\n    suggested_reply: 'Thank you for your email. We will get back to you shortly.',\n    action_required: false,\n    parse_error: e.message,\n    from: $('Extract Content').item.json.from,\n    from_name: $('Extract Content').item.json.from_name,\n    subject: $('Extract Content').item.json.subject,\n    body: $('Extract Content').item.json.body,\n    date: $('Extract Content').item.json.date\n  };\n}"
      },
      "id": "9a6a4dc2-02a1-43ea-baf5-835133688135",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        272
      ]
    },
